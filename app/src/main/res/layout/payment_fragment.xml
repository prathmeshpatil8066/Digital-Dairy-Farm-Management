<?xml version="1.0" encoding="utf-8"?>

<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">



        <EditText
            android:id="@+id/etCustomerId"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Enter Customer ID"
            android:inputType="number"
            android:padding="12dp"
            android:background="@android:drawable/edit_text"/>



        <TextView
            android:id="@+id/tvCustomerName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Customer Name"
            android:textSize="18sp"
            android:textStyle="bold"
            android:layout_marginTop="12dp"/>



        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="12dp"
            android:background="#F5F5F5"
            android:layout_marginTop="10dp">

            <TextView
                android:id="@+id/tvStartDate"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Start Date : -"
                android:textSize="16sp"/>

            <TextView
                android:id="@+id/tvEndDate"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="End Date : -"
                android:textSize="16sp"/>

        </LinearLayout>



        <Button
            android:id="@+id/btnLoadSlot"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Load Slot Details"
            android:layout_marginTop="12dp"/>



        <TextView
            android:id="@+id/tvSlotBill"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Slot Bill : ₹0"
            android:textSize="18sp"
            android:textStyle="bold"
            android:layout_marginTop="16dp"/>



        <TextView
            android:id="@+id/tvTotalPayable"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Total Payable : ₹0"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="#D32F2F"
            android:layout_marginTop="8dp"/>



        <EditText
            android:id="@+id/etPaidAmount"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Enter Cash Amount"
            android:inputType="numberDecimal"
            android:padding="12dp"
            android:layout_marginTop="16dp"
            android:background="@android:drawable/edit_text"/>



        <Button
            android:id="@+id/btnSave"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Save Payment"
            android:layout_marginTop="14dp"/>


    </LinearLayout>

</ScrollView>